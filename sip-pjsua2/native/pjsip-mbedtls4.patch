 {
     mbedtls_sock_t *mssock = (mbedtls_sock_t *)ssock;
+    pj_size_t pending = 0;
     int ret;
 
     /* Hold write_mutex because mbedtls_ssl_read() may produce
@@ -868,17 +989,46 @@
      * SSL_read approach).
